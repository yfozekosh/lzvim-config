    fi
    PROMPT_COMMAND='PS1="(>_>)${node_name} ${PS1_GREEN}${PS1_BOLD}${PS1_MAGENTA}$(__git_prompt_info)${PS1_YELLOW}$(__short_path_under_project)${PS1_GREEN}${PS1_BOLD}${PS1_RESET}\n\$ "'

    # If no internet connection - echo in red caps that there is no internet connection and vpn should be disabled
