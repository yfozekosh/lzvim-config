#!/bin/bash

# .bashrc
#
# ---- auto tmux ----
# New interactive shell (e.g. Alacritty -> WSL): if no tmux session exists anywhere
# and we're not already inside tmux, jump straight into a new tmux session.
# If a session already exists, leave it alone (attach manually with `tmux attach`)
# so we don't force-attach onto someone else's active work.
if command -v tmux &>/dev/null && [ -z "$TMUX" ] && [ -n "$PS1" ]; then
  if ! tmux list-sessions &>/dev/null; then
    exec tmux new-session
  fi
fi

