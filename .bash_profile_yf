# ---- git log helpers ----
gg() {
  local n=7
  # If first arg is an int, treat it as n
  if [[ "${1-}" =~ ^-?[0-9]+$ ]]; then
    n="$1"
    shift
  fi

  if ((n > 0)); then
    git log --oneline --graph --decorate --all -n "$n" "$@"
  else
    git log --oneline --graph --decorate --all "$@"
  fi
}
gga() { gg 0 "$@"; }
cgg() {
  cc
  gg
}

