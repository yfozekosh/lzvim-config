    if ! ping -c 1 -W 3 google.com &>/dev/null; then
      echo ""
      echo -e "${PS1_RED}${PS1_BOLD}NO INTERNET CONNECTION - DISABLE VPN${PS1_RESET}"
    fi
  fi
fi

