gh-cookie-clear() {
  local state_file="$HOME/.config/copilot-usage/state.json"
  local cache_file="$HOME/.cache/tmux-copilot-usage"
  local lock_file="$HOME/.cache/tmux-copilot-usage.lock"
  local login_lock="$HOME/.config/copilot-usage/login.lock"
  rm -f "$state_file" "$cache_file" "$lock_file" "$login_lock"
  echo "Cleared saved Copilot usage session ($state_file). Next tmux refresh will trigger re-login."
}

# Save your GitHub password locally (chmod 600) so re-login auto-fills it.
# Typed hidden (not echoed), never leaves this machine except to github.com.
gh-cookie-setpass() {
  local dir="$HOME/.config/copilot-usage"
  local pass_file="$dir/password"
  mkdir -p "$dir"
  chmod 700 "$dir"
  local pass
  read -r -s -p "GitHub password (hidden, stored locally): " pass
  echo
  if [ -z "$pass" ]; then
    echo "Empty password, not saving."
    return 1
  fi
  printf '%s' "$pass" > "$pass_file"
  chmod 600 "$pass_file"
  unset pass
  echo "Saved to $pass_file (chmod 600). Re-login will now auto-fill it; you'll still be asked for 2FA."
}

gh-cookie-unsetpass() {
  rm -f "$HOME/.config/copilot-usage/password"
  echo "Removed saved password."
}

