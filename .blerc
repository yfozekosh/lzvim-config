# ble.sh user config (~/.blerc), symlinked by setup.sh's link_configs.
#
# Tone down the default completion/autosuggestion faces, which use bright,
# high-contrast backgrounds (near-white auto_complete background, fully
# inverted menu selection) - more like PowerShell's muted, low-contrast
# ghost-text and selection highlighting.

# Inline autosuggestion ("ghost text"): default is bg=254 (near-white) which
# stands out as a bright block. Use a plain dim foreground instead, no
# background, so it just looks like grayed-out text (fish/PowerShell style).
ble-face auto_complete=fg=244

# Tab-triggered completion menu: default menu_complete_selected is "reverse"
# (full invert, very high contrast). Use a subtle dark-gray highlight instead.
ble-face menu_complete_selected=fg=253,bg=238

# Completion menu filter/search input: default is fg=16,bg=229 (black text on
# bright yellow). Match the muted selection highlight above instead.
ble-face menu_filter_input=fg=253,bg=238

# Tab: standard bash-like completion behaviour (complete common prefix /
# just list candidates), with no auto-entering of the highlighted
# menu-selection/cycling mode (default: repeated Tab presses auto-enter
# selection mode). Ctrl+Tab is already bound by default to explicitly
# trigger that selection-cycling ("menu-complete") mode, unaffected by
# this option, so it's still available on demand.
bleopt complete_menu_complete=

# Live syntax highlighting while a command is still being typed / invalid:
# these all default to solid, high-contrast background blocks. Switch them
# to plain colored (and underlined, for real errors) foreground text instead
# - still clearly distinguishable, without the bright block backgrounds.

# Command word while it doesn't (yet) match anything on PATH - e.g. still
# mid-typing, or a typo. Default: bg=124 (dark red block), fg=231 (white).
ble-face command_suffix_new=fg=203,underline

# Command word once it does match something valid. Default: bg=28 (green
# block), fg=231 (white).
ble-face command_suffix=fg=34

# Real syntax errors (unmatched quote/paren, etc). Default: bg=203 (bright
# pink-red block), fg=231 (white).
ble-face syntax_error=fg=203,underline

# Invalid/unrecognized argument. Default: bg=225 (pale yellow block),
# fg=black.
ble-face argument_error=fg=221,underline
